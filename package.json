{
  "name": "pawse",
  "version": "1.0.0",
  "description": "A secure, resilient, and adorable Pomodoro timer built with Electron.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node start.js",
    "build": "electron-builder --win",
    "build:store": "electron-builder --win appx",
    "build:exe": "electron-builder --win nsis",
    "test": "jest"
  },
  "keywords": [
    "pomodoro",
    "electron",
    "productivity",
    "cats"
  ],
  "author": "Jude Keith Escritor & Jasmin Joyce Obligado",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sqlite3": "^6.0.1"
  },
  "overrides": {
    "tar@<=7.5.17": "7.5.17"
  },
  "build": {
    "appId": "com.pawse.app",
    "publish": [
      {
        "provider": "github",
        "owner": "educ-jkescritor",
        "repo": "Pawse"
      }
    ],
    "productName": "Pawse",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "src/assets/logos/logo.png"
    },
    "appx": {
      "identityName": "JudeKeithEscritor.Pawse",
      "publisher": "CN=0BD60335-B7BE-4ECE-96DA-ADCD12973CDD",
      "publisherDisplayName": "Jude Keith Escritor",
      "applicationId": "Pawse",
      "displayName": "Pawse",
      "languages": [
        "en-US"
      ],
      "backgroundColor": "#F6F8F7",
      "showNameOnTiles": true
    }
  }
}
