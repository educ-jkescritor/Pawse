{
  "name": "pawse",
  "version": "1.0.0",
  "description": "A secure, resilient, and adorable Pomodoro timer built with Electron.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node start.js",
    "build": "electron-builder --win",
    "build:store": "electron-builder --win appx",
    "build:exe": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mw",
    "test": "jest"
  },
  "keywords": [
    "pomodoro",
    "electron",
    "productivity",
    "cats"
  ],
  "author": "Jude Keith Escritor & Jasmin Joyce Obligado",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sqlite3": "^6.0.1"
  },
  "overrides": {
    "tar@<=7.5.17": "7.5.17"
  },
  "build": {
    "appId": "com.pawse.app",
    "publish": [
      {
        "provider": "github",
        "owner": "educ-jkescritor",
        "repo": "Pawse"
      }
    ],
    "productName": "Pawse",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "src/assets/logos/logo.png"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "src/assets/logos/logo.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "appx": {
      "identityName": "JudeKeithEscritor.Pawse",
      "publisher": "CN=0BD60335-B7BE-4ECE-96DA-ADCD12973CDD",
      "publisherDisplayName": "Jude Keith Escritor",
      "applicationId": "Pawse",
      "displayName": "Pawse",
      "languages": [
        "en-US"
      ],
      "backgroundColor": "#F6F8F7",
      "showNameOnTiles": true
    }
  }
}
